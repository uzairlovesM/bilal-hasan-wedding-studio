{
  "name": "bilal-hasan-wedding-studio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty",
    "postinstall": "node tools/copy-decoders.mjs",
    "optimize:model": "node tools/optimize-model.mjs",
    "optimize:model:draco": "gltf-transform draco public/models/envelope-prop.glb public/models/envelope-draco.glb --method edgebreaker",
    "verify": "node tools/verify-project.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@rive-app/canvas": "^2.51.0",
    "animejs": "^4.5.0",
    "cannon-es": "^0.20.0",
    "gsap": "^3.15.1",
    "howler": "^2.2.4",
    "lenis": "^1.3.17",
    "lottie-web": "^5.13.0",
    "matter-js": "^0.20.0",
    "meshoptimizer": "^0.22.0",
    "motion": "^14.14.0",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tone": "^15.1.22",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.2",
    "vite": "^8.3.8",
    "@gltf-transform/cli": "^4.5.1"
  }
}
